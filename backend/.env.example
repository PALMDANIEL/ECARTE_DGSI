NODE_ENV=development
PORT=3004
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ecarte?schema=public
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=user@example.com
EMAIL_PASS=password
FRONTEND_URL=http://localhost:4200
QR_BASE_URL=http://localhost:4200/card/
MAX_FAILED_ATTEMPTS=5
LOCK_DURATION=900000
CARD_TOKEN_KEY=generate_with_openssl_rand_hex_32
ACCESS_BASE_URL=http://localhost:4200/q/
# Stockage privé des PDF et pièces jointes des demandes (à sauvegarder avec la base)
PRIVATE_STORAGE_DIR=./private-storage
# Balayage des rappels et escalades de délais, en minutes (0 = désactivé)
ESCALATION_SWEEP_MINUTES=15
# Compte SUPER_ADMIN créé par `npm run seed`
SEED_ADMIN_EMAIL=admin@ecarte.local
SEED_ADMIN_PASSWORD=change_me_seed
