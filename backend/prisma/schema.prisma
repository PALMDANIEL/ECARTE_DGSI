generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CardStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  EXPIRED
  REPLACED
}

enum OrgUnitType {
  SG
  DG
  DIRECTION
  SERVICE
  UNITE
}

enum RequestStatus {
  DRAFT
  IN_PROGRESS
  RETURNED
  APPROVED
  REJECTED
  CANCELLED
}

enum StepKind {
  AVIS
  VISA
  TRAITEMENT
  DECISION
}

enum StepResolution {
  POSITION
  SUPERVISOR_LEVEL
  UNIT_TYPE_HEAD
}

enum StepResult {
  PENDING
  FAVORABLE
  UNFAVORABLE
  APPROVED
  REJECTED
  RETURNED
  SKIPPED
}

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

model Company {
  id             String               @id @default(cuid())
  name           String               @unique
  logo           String?
  phone          String?
  email          String?
  website        String?
  address        String?
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  users          User[]
  teams          Team[]
  cards          BusinessCard[]
  city           String?
  orgUnits       OrgUnit[]
  positions      Position[]
  agentProfiles  AgentProfile[]
  ruleParameters RuleParameter[]
  requestTypes   RequestType[]
  absenceTypes   AbsenceType[]
  workflows      WorkflowDefinition[]
  requests       Request[]
  formTemplates  FormTemplate[]
  leaveDecisions LeaveDecision[]

  @@map("companies")
}

model Team {
  id        String   @id @default(cuid())
  name      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]

  @@index([companyId])
  @@map("teams")
}

model User {
  id                  String           @id @default(cuid())
  firstName           String
  lastName            String
  email               String           @unique
  password            String
  phone               String?
  photo               String?
  jobTitle            String?
  department          String?
  companyId           String
  company             Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  teamId              String?
  team                Team?            @relation(fields: [teamId], references: [id], onDelete: SetNull)
  role                Role             @default(EMPLOYEE)
  isActive            Boolean          @default(true)
  isVerified          Boolean          @default(false)
  refreshToken        String?
  failedAttempts      Int              @default(0)
  lockUntil           DateTime?
  lastLogin           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  cards               BusinessCard[]
  notifications       Notification[]
  agentProfile        AgentProfile?
  supervisedAgents    AgentProfile[]   @relation("Supervisor")
  positionHoldings    PositionHolder[]
  delegationsReceived Delegation[]     @relation("Delegate")
  heldCards           BusinessCard[]   @relation("CardHolder")
  requests            Request[]        @relation("RequestAgent")
  leaveDecisions      LeaveDecision[]
  stepsAssigned       RequestStep[]    @relation("StepAssignee")
  stepsActed          RequestStep[]    @relation("StepActor")

  @@unique([email, companyId])
  @@index([companyId])
  @@index([teamId])
  @@map("users")
}

model BusinessCard {
  id           String           @id @default(cuid())
  slug         String           @unique
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  photo        String?
  fullName     String
  jobTitle     String?
  ministry     String?
  direction    String?
  service      String?
  phoneMobile  String?
  phoneWork    String?
  email        String?
  whatsapp     String?
  website      String?
  linkedin     String?
  facebook     String?
  instagram    String?
  tiktok       String?
  address      String?
  gpsLat       Float?
  gpsLng       Float?
  isActive     Boolean          @default(true)
  isArchived   Boolean          @default(false)
  qrCodeUrl    String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  scans        Scan[]
  // --- Carte professionnelle (module demandes) ---
  agentId      String?
  agent        User?            @relation("CardHolder", fields: [agentId], references: [id], onDelete: SetNull)
  cardNumber   String?          @unique
  status       CardStatus       @default(PENDING)
  issuedAt     DateTime?
  expiresAt    DateTime?
  replacedById String?
  credentials  CardCredential[]
  events       CardEvent[]

  @@index([userId])
  @@index([companyId])
  @@index([slug])
  @@index([agentId])
  @@map("business_cards")
}

model Scan {
  id        String       @id @default(cuid())
  cardId    String
  card      BusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  scannedAt DateTime     @default(now())
  ip        String?
  country   String?
  city      String?
  device    String?
  os        String?
  browser   String?
  referrer  String?
  createdAt DateTime     @default(now())

  @@index([cardId])
  @@index([scannedAt])
  @@map("scans")
}

model Notification {
  requestId String?
  link      String?
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}

// ======================= Module demandes administratives — phase 1 =======================

model OrgUnit {
  id        String         @id @default(cuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    OrgUnit?       @relation("OrgTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  OrgUnit[]      @relation("OrgTree")
  type      OrgUnitType
  code      String
  name      String
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  positions Position[]
  agents    AgentProfile[]

  @@unique([companyId, code])
  @@index([parentId])
  @@map("org_units")
}

model Position {
  id          String           @id @default(cuid())
  companyId   String
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orgUnitId   String?
  orgUnit     OrgUnit?         @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  code        String
  label       String
  civility    String?
  level       Int              @default(0)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  holders     PositionHolder[]
  delegations Delegation[]

  @@unique([companyId, code])
  @@index([orgUnitId])
  @@map("positions")
}

model PositionHolder {
  id         String    @id @default(cuid())
  positionId String
  position   Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startsAt   DateTime  @default(now())
  endsAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([positionId])
  @@index([userId])
  @@map("position_holders")
}

model Delegation {
  id           String   @id @default(cuid())
  positionId   String
  position     Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  delegateId   String
  delegate     User     @relation("Delegate", fields: [delegateId], references: [id], onDelete: Cascade)
  startsAt     DateTime
  endsAt       DateTime
  requestTypes String[]
  reason       String?
  createdById  String?
  createdAt    DateTime @default(now())

  @@index([positionId])
  @@index([delegateId])
  @@map("delegations")
}

model AgentProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  matricule         String
  civility          String?
  grade             String?
  corps             String?
  hireDate          DateTime?
  serviceStartDate  DateTime?
  regime            String    @default("FONCTIONNAIRE")
  orgUnitId         String?
  orgUnit           OrgUnit?  @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  supervisorId      String?
  supervisor        User?     @relation("Supervisor", fields: [supervisorId], references: [id], onDelete: SetNull)
  pinHash           String?
  pinFailedAttempts Int       @default(0)
  pinLockedUntil    DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([companyId, matricule])
  @@index([orgUnitId])
  @@index([supervisorId])
  @@map("agent_profiles")
}

model CardCredential {
  id           String       @id @default(cuid())
  cardId       String
  card         BusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tokenHash    String       @unique
  tokenEnc     String
  tokenPrefix  String
  createdAt    DateTime     @default(now())
  revokedAt    DateTime?
  revokeReason String?

  @@index([cardId])
  @@map("card_credentials")
}

model CardEvent {
  id        String       @id @default(cuid())
  cardId    String
  card      BusinessCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  type      String
  actorId   String?
  reason    String?
  metadata  Json?
  createdAt DateTime     @default(now())

  @@index([cardId])
  @@map("card_events")
}

model RuleParameter {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  key            String
  value          Json
  validFrom      DateTime  @default(now())
  validTo        DateTime?
  legalReference String?
  comment        String?
  createdById    String?
  createdAt      DateTime  @default(now())

  @@index([companyId, key])
  @@map("rule_parameters")
}

model AuditLog {
  id         String   @id @default(cuid())
  seq        Int      @unique @default(autoincrement())
  companyId  String?
  actorId    String?
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  prevHash   String?
  hash       String
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([companyId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ======================= Module demandes administratives — phase 2 =======================

model RequestType {
  id                    String               @id @default(cuid())
  companyId             String
  company               Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  prefix                String
  requiresPriorDecision Boolean              @default(false)
  attachmentRules       Json                 @default("[]")
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  requests              Request[]
  workflows             WorkflowDefinition[]

  @@unique([companyId, code])
  @@map("request_types")
}

model AbsenceType {
  id               String   @id @default(cuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code             String
  name             String
  unit             String   @default("JOUR")
  annualCap        Float?
  deductsFromLeave Boolean  @default(false)
  legalReference   String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([companyId, code])
  @@map("absence_types")
}

model WorkflowDefinition {
  id            String         @id @default(cuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestTypeId String
  requestType   RequestType    @relation(fields: [requestTypeId], references: [id], onDelete: Cascade)
  version       Int
  name          String?
  isActive      Boolean        @default(true)
  validFrom     DateTime       @default(now())
  validTo       DateTime?
  createdById   String?
  createdAt     DateTime       @default(now())
  steps         WorkflowStep[]
  requests      Request[]

  @@unique([requestTypeId, version])
  @@index([companyId, requestTypeId])
  @@map("workflow_definitions")
}

model WorkflowStep {
  id                  String             @id @default(cuid())
  workflowId          String
  workflow            WorkflowDefinition @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  order               Int
  kind                StepKind
  label               String?
  resolution          StepResolution
  positionId          String?
  level               Int?
  unitType            OrgUnitType?
  isMandatory         Boolean            @default(true)
  conditionJson       Json?
  deadlineDays        Int?
  escalatePositionId  String?
  allowReturn         Boolean            @default(true)
  rejectOnUnfavorable Boolean            @default(false)

  @@unique([workflowId, order])
  @@map("workflow_steps")
}

model Request {
  id              String              @id @default(cuid())
  companyId       String
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reference       String              @unique
  typeId          String
  type            RequestType         @relation(fields: [typeId], references: [id])
  agentId         String
  agent           User                @relation("RequestAgent", fields: [agentId], references: [id], onDelete: Cascade)
  status          RequestStatus       @default(DRAFT)
  round           Int                 @default(1)
  workflowId      String?
  workflow        WorkflowDefinition? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  data            Json
  snapshot        Json?
  leaveDecisionId String?
  leaveDecision   LeaveDecision?      @relation("DecisionOfRequest", fields: [leaveDecisionId], references: [id], onDelete: SetNull)
  submittedAt     DateTime?
  closedAt        DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  steps           RequestStep[]
  documents       RequestDocument[]
  attachments     RequestAttachment[]
  issuedDecision  LeaveDecision?      @relation("DecisionFromRequest")

  @@index([companyId, status])
  @@index([agentId])
  @@index([typeId])
  @@map("requests")
}

model RequestStep {
  id                  String     @id @default(cuid())
  requestId           String
  request             Request    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  round               Int        @default(1)
  order               Int
  kind                StepKind
  label               String
  positionId          String?
  assigneeId          String?
  assignee            User?      @relation("StepAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  titleSnapshot       String?
  result              StepResult @default(PENDING)
  actorId             String?
  actor               User?      @relation("StepActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorName           String?
  actorTitle          String?
  comment             String?
  decidedAt           DateTime?
  activatedAt         DateTime?
  dueAt               DateTime?
  rejectOnUnfavorable Boolean    @default(false)
  allowReturn         Boolean    @default(true)
  deadlineDays        Int?
  note                String?

  @@index([requestId, round, order])
  @@index([positionId])
  @@index([assigneeId])
  @@map("request_steps")
}

model RequestDocument {
  id          String   @id @default(cuid())
  requestId   String
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  version     Int
  path        String
  sha256      String
  size        Int
  reason      String
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([requestId, version])
  @@map("request_documents")
}

model RequestAttachment {
  id           String   @id @default(cuid())
  requestId    String
  request      Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  code         String?
  name         String
  mime         String
  size         Int
  sha256       String
  path         String
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([requestId])
  @@map("request_attachments")
}

model RequestCounter {
  id        String @id @default(cuid())
  companyId String
  prefix    String
  year      Int
  last      Int    @default(0)

  @@unique([companyId, prefix, year])
  @@map("request_counters")
}

model LeaveDecision {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  agentId   String
  agent     User      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  number    String
  year      Int
  days      Int
  status    String    @default("VALID")
  issuedAt  DateTime  @default(now())
  requestId String?   @unique
  request   Request?  @relation("DecisionFromRequest", fields: [requestId], references: [id], onDelete: SetNull)
  usedBy    Request[] @relation("DecisionOfRequest")
  createdAt DateTime  @default(now())

  @@unique([companyId, number])
  @@index([agentId])
  @@map("leave_decisions")
}

model FormTemplate {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  typeCode    String
  version     Int
  html        String
  css         String
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([companyId, typeCode, version])
  @@map("form_templates")
}
